srcdir := $(shell dirname $(realpath $(firstword $(MAKEFILE_LIST))))
subdir=${srcdir}
targetname=whole_array
devicename=npu2
kernelsrc:= $(firstword $(wildcard ${srcdir}/../*mm.cc))
hostsrc := $(firstword $(wildcard ${srcdir}/../*bfp_test.cpp))

n_aie_cols?=4
aieargs+=--n-aie-cols ${n_aie_cols}

# M, K, N: final GEMM dimensions
M?=512
K?=512
N?=512

# m, k, n: single AIE core GEMM dimensions
m?=64
k?=64
n?=64

include ${srcdir}/../makefile_common
rm -rf build _build whole_array.exe
rm -rf _build
mkdir -p _build
cd _build &&  cmake -E env CXXFLAGS="-std=c++23 -ggdb -DDTYPE_IN= -DDTYPE_OUT= -DDTYPE_ACC=" \
